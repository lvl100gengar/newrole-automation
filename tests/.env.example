# Copy to tests/.env (git-ignored) to run the suite against a real host as well as the fake.
# Without NRB_TARGET only the offline fake backend runs. Real environment variables override this file.

NRB_TARGET=user@192.0.2.10
NRB_ROLE=sysadm_r

# ssh login: either a key ...
# NRB_SSH_KEY=~/.ssh/id_rsa
# ... or leave it unset and ssh will use the same password via SSH_ASKPASS.

# The account's password (also used for newrole and sudo). Prefer a 0600 file:
NRB_PASSWORD_FILE=./pw
# NRB_PASSWORD=...

# Extra ssh client options, e.g. -oStrictHostKeyChecking=accept-new
# NRB_SSH_OPTS=

# Interpreter to run on the target (default python3). Use "python" for a target that only has
# Python 2.7, e.g. stock RHEL/CentOS 7.
# NRB_REMOTE_PYTHON=python3

# Nesting test (ssh A, newrole, ssh B, newrole). B is named as seen FROM the target.
# NRB_NEST_KEY is a private key path ON the target; leave it unset to use password auth
# through a temporary askpass helper.
# NRB_NEST_HOST=user@192.0.2.10
# NRB_NEST_KEY=

# Wrong-password test counts toward pam_faillock; only runs against a real host if set to 1.
# NRB_ALLOW_LOCKOUT=1

# fake | real | both (default: fake, or both when NRB_TARGET is set)
# NRB_BACKEND=both
